{
  // Type-checking only — nothing is compiled or emitted. The page still
  // runs the plain js/*.js files directly. Every file under js/ and data/
  // is checked (checkJs); a file can opt out with `// @ts-nocheck`, but
  // shouldn't need to.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "data/**/*.js", "js/**/*.js"]
}
